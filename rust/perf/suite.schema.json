{
  "title": "StaxTrace performance suite receipt",
  "type": "object",
  "required": [
    "schema", "run_id", "policy_digest", "runner", "scenario_count",
    "scenario_digests", "scenarios", "baseline_comparison", "status"
  ],
  "properties": {
    "schema": {"const": "staxtrace.performance-suite-receipt"},
    "run_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runner": {
      "type": "object",
      "required": ["os", "architecture", "runner_class", "toolchain", "key"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "runner_class": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "toolchain": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scenario_count": {"type": "integer", "minimum": 1},
    "scenario_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "scenarios": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "baseline_comparison": {
      "type": "object",
      "required": ["mode", "baseline_file", "comparisons"],
      "properties": {
        "mode": {"enum": ["absolute_guards", "same_runner_baseline"]},
        "baseline_file": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9_-]{0,126}\\.json$"
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["scenario", "checks", "passed"],
            "properties": {
              "scenario": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "checks": {
                "type": "object",
                "required": ["p99_ms", "peak_rss_bytes", "peak_open_files"],
                "properties": {
                  "p99_ms": {"type": "boolean"},
                  "peak_rss_bytes": {"type": "boolean"},
                  "peak_open_files": {"type": "boolean"},
                  "throughput_per_second": {"type": "boolean"}
                },
                "additionalProperties": false
              },
              "passed": {"const": true}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "status": {"const": "pass"}
  },
  "additionalProperties": false
}
