{
  "title": "StaxTrace performance workload policy",
  "type": "object",
  "required": [
    "schema", "suite_timeout_seconds", "setup_timeout_seconds",
    "scenario_timeout_seconds", "runner_classes",
    "resource_limits", "resource_observation", "baseline_policy", "scenarios"
  ],
  "properties": {
    "schema": {"const": "staxtrace.performance-workloads"},
    "suite_timeout_seconds": {"type": "integer", "minimum": 1},
    "setup_timeout_seconds": {"type": "integer", "minimum": 1},
    "scenario_timeout_seconds": {"type": "integer", "minimum": 1},
    "runner_classes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
    },
    "resource_limits": {
      "type": "object",
      "required": ["peak_rss_bytes", "open_files"],
      "properties": {
        "peak_rss_bytes": {"type": "integer", "minimum": 1},
        "open_files": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "resource_observation": {
      "type": "object",
      "required": ["interval_milliseconds", "observer_wall_seconds_limit"],
      "properties": {
        "interval_milliseconds": {"type": "integer", "minimum": 1},
        "observer_wall_seconds_limit": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "baseline_policy": {
      "type": "object",
      "required": [
        "clean_run_count", "latency_regression_fraction", "rss_regression_fraction",
        "open_file_regression_fraction", "throughput_regression_fraction"
      ],
      "properties": {
        "clean_run_count": {"type": "integer", "minimum": 1},
        "latency_regression_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "rss_regression_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "open_file_regression_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "throughput_regression_fraction": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "scenarios": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["fixture", "samples", "guard", "test", "resources"],
        "properties": {
          "fixture": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
            "additionalProperties": {"type": "integer", "minimum": 0}
          },
          "samples": {"type": ["integer", "null"], "minimum": 1},
          "guard": {
            "type": "object",
            "required": ["metric", "comparison", "limit"],
            "properties": {
              "metric": {"enum": ["p99_ms", "throughput_per_second", "reader_p99_ms"]},
              "comparison": {"enum": ["at_most", "at_least"]},
              "limit": {"type": "number", "minimum": 0},
              "errors": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "test": {
            "type": "object",
            "required": ["package", "integration_test", "test_name"],
            "properties": {
              "package": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
              "integration_test": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "test_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
            },
            "additionalProperties": false
          },
          "resources": {
            "type": "object",
            "required": [
              "mode", "minimum_rss_samples", "minimum_open_file_samples",
              "child_process_samples"
            ],
            "properties": {
              "mode": {"enum": ["edge", "continuous"]},
              "minimum_rss_samples": {"type": "integer", "minimum": 2},
              "minimum_open_file_samples": {"type": "integer", "minimum": 2},
              "child_process_samples": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
